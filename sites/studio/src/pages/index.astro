---
import { byId } from "@bykami/content";
import BaseLayout from "@bykami/ui/BaseLayout.astro";
import Faq from "@bykami/ui/Faq.astro";
import Gallery from "@bykami/ui/Gallery.astro";
import InstagramPosts from "@bykami/ui/InstagramPosts.astro";
import PriceList from "@bykami/ui/PriceList.astro";
import SectionHeader from "@bykami/ui/SectionHeader.astro";
import TiktokVideos from "@bykami/ui/TiktokVideos.astro";

const vertical = byId("studio");

/**
 * Real sessions, from the studio's own Instagram — the generated stand-ins these
 * replaced are gone. Downloaded at full resolution rather than screenshotted:
 * Instagram serves 1440 × 1800 to the embed, which is well past what a 360px
 * grid cell needs, so nothing here is the soft re-encode `assets-needed.md`
 * warns about. Sources, in display order: DU5jfnbjxp8, DWtQq5ID3zM,
 * DVVdg2UD9wF, DJivXHkx9N0, DJiwujMRnba, DWyYzefjzRq.
 *
 * That order is monochrome and colour interleaved rather than grouped. Grouped,
 * the grid split into a black-and-white half and a colour half and read as two
 * gallerias stacked; strict alternation only moves the seam, making a solid row
 * at three columns or a solid column at two. This pattern leaves no uniform row
 * at either width.
 *
 * 04 and 05 were posted as photographs of framed prints, hung and lit. Cropped
 * to the picture inside, because the mat and the wall are packaging and this
 * grid is meant to show results — and because two frames among six unframed
 * ones reads as an accident rather than a choice.
 *
 * Half are black and white and half are in colour, which is the studio's actual
 * range and so is left alone. Four carry the studio's own overlaid type — these
 * are the posts as published, not retouched copies of them.
 *
 * Recognisable customers appear here. They are already public on the studio's
 * own account, but a website is a different surface from a feed; if anyone asks
 * to come down, drop a replacement over the same file name.
 */
const gallery = [
  {
    src: "/img/studio-01.jpg",
    alt: "Hasil foto hitam putih: seorang perempuan duduk santai di kursi lipat studio",
  },
  {
    src: "/img/studio-02.jpg",
    alt: "Hasil foto sesi Lebaran: sepasang orang berbusana muslim di depan latar kain",
  },
  {
    src: "/img/studio-03.jpg",
    alt: "Hasil foto konsep New Look: seorang perempuan berblazer hitam berpose jongkok",
  },
  {
    src: "/img/studio-04.jpg",
    alt: "Hasil foto hitam putih: dua orang berpose di bawah lampu sorot bulat",
  },
  {
    src: "/img/studio-05.jpg",
    alt: "Hasil foto hitam putih: satu keluarga dengan anak di bawah lampu sorot",
  },
  {
    src: "/img/studio-06.jpg",
    alt: "Hasil sesi yearbook: tiga perempuan berkebaya berpose bersama dalam tiga panel",
  },
];
---

<BaseLayout
  vertical={vertical}
  title="Self Photo Studio Banyuwangi — studio by KAMI"
  description="Self photo studio, photobox, dan pas foto di Jajag, Banyuwangi. Lihat daftar paket dan harga lengkap, lalu booking lewat WhatsApp."
>
  {/*
   * `.enter` is the CSS half of the reveal system — see tokens.css. The hero is
   * the LCP element on this page and does not wait for an island; the 0.1s on
   * the lede is Chimera's second stagger step.
   */}
  <section class="wrap hero">
    <h1 class="enter" style="--enter-y: 32px">Self photo studio di Banyuwangi</h1>
    <p class="lede enter" style="--enter-delay: 0.1s">
      Sewa ruang studio yang sudah tertata lighting-nya, lalu potret dirimu sendiri
      pakai remote shutter. Tanpa fotografer di dalam ruangan, hasil bisa langsung
      dicetak.
    </p>
  </section>

  <Gallery images={gallery} heading="Hasil di studio" label="Galeri" />

  <PriceList vertical={vertical} />

  <section class="wrap section">
    <SectionHeader heading="Cara kerjanya" label="Alur" />
    <ol>
      <li>Pilih paket sesuai jumlah orang dan durasi yang kamu mau.</li>
      <li>Chat admin lewat WhatsApp untuk memesan slot.</li>
      <li>Datang ke studio, masuk ruang yang sudah siap dengan lighting.</li>
      <li>Potret sendiri pakai remote shutter selama durasi paketmu.</li>
      <li>Pilih foto terbaik untuk dicetak sebelum pulang.</li>
    </ol>
  </section>

  <InstagramPosts vertical={vertical} />

  <TiktokVideos vertical={vertical} />

  <Faq vertical={vertical} />
</BaseLayout>

<style>
  .hero {
    margin-block: var(--space-12) var(--space-section);
  }

  .lede {
    font-size: 18px;
    color: var(--muted);
  }


  ol {
    max-width: var(--measure);
    margin: 0;
    padding-left: 1.25rem;
  }

  li {
    margin-bottom: var(--space-2);
  }
</style>
