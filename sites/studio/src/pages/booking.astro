---
import { byId, valueOf } from "@bykami/content";
import BaseLayout from "@bykami/ui/BaseLayout.astro";
import SectionHeader from "@bykami/ui/SectionHeader.astro";

const vertical = byId("studio");

/**
 * Where the booking API lives. The sites are static on Cloudflare Pages and the
 * API is a Go binary behind a tunnel, so this is a cross-origin call by
 * construction — `internal/httpapi/booking.go` carries the allowlist that permits
 * it. Overridable at build time so `astro dev` can point at a local binary, which
 * is also how the flow below was driven end to end.
 */
const apiBase = import.meta.env["BYKAMI_API_BASE"] ?? "https://app.bykami.id";

/**
 * The terms, assembled from the catalogue rather than retyped here.
 *
 * Both of these are facts about the business with a source recorded against them,
 * and the studio made a customer tick a box agreeing to the first before it would
 * take a booking. Rendering them from the same records the FAQ renders is what
 * stops the page and the FAQ from drifting into two different cancellation
 * policies — and this page is the one place where being wrong about it costs
 * somebody twenty thousand rupiah.
 */
const terms = ["reschedule", "bayar-dp"]
  .map((id) => vertical.faqs.find((f) => f.id === id))
  .map((f) => (f ? valueOf(f.answer) : undefined))
  .filter((a): a is string => a !== undefined);

const whatsapp = vertical.nap ? valueOf(vertical.nap.whatsapp) : undefined;
const waHref = whatsapp
  ? `https://wa.me/${whatsapp}?text=${encodeURIComponent(
      `Halo ${vertical.displayName}, saya mau booking.`,
    )}`
  : undefined;

const mapsUrl = vertical.nap ? valueOf(vertical.nap.mapsUrl) : undefined;
---

<BaseLayout
  vertical={vertical}
  path="/booking"
  trail={[{ name: "Booking", path: "/booking" }]}
  title="Booking Self Photo & Photobox — studio by KAMI"
  description="Pilih paket dan jam sesi di studio by KAMI Jajag, Banyuwangi. Booking tanpa DP, jadwal langsung terkonfirmasi."
>
  <section class="wrap hero">
    <h1 class="enter" style="--enter-y: 32px">Booking</h1>
    <p class="lede enter" style="--enter-delay: 0.1s">
      Pilih paket, pilih jam yang masih kosong, dan jadwalmu langsung terkonfirmasi.
      Tanpa DP — pembayaran di studio.
    </p>
  </section>

  <section id="jadwal" class="wrap section">
    <SectionHeader heading="Pilih jadwal" label="Booking" />

    {/*
      The no-JavaScript path, and the reason it is a real path rather than an
      apology: this replaced a WhatsApp link that worked everywhere, so a visitor
      whose browser cannot run the flow has to be left no worse off than before.
      Hidden the moment BaseLayout's head script marks the document scripted.
    */}
    {/*
      "di bawah" until the price list below it went: this page showed the whole
      catalogue twice, once as cards you can click and once as cards you cannot,
      and the second copy was the one a visitor scrolled past. The list still
      exists in full on the home page, which is where this now sends anyone who
      cannot run the flow.
    */}
    <p class="fallback">
      Untuk memilih jam sendiri, aktifkan JavaScript.
      {waHref && (
        <>
          {" "}Atau <a href={waHref} rel="noopener">chat admin lewat WhatsApp</a> — daftar
          paket dan harga ada di <a href="/#harga">halaman depan</a>.
        </>
      )}
    </p>

    <div class="flow" data-flow>
      {/*
        Four steps in one section, switched by hidden. Not four routes: a booking
        abandoned halfway is the thing to avoid, and a page load between choosing a
        time and typing a name is an invitation to abandon it.

        Nothing in here carries data-reveal. The observer in BaseLayout queries the
        DOM once at parse time and unobserves as it fires, so an element revealed
        into existence later would keep its from-state and sit at opacity 0
        permanently. The section heading above is the reveal target; its contents
        are not.
      */}
      <ol class="crumbs ui" data-crumbs>
        <li aria-current="step">Paket</li>
        <li>Jam</li>
        <li>Data</li>
      </ol>

      <div data-step="service">
        <h3 class="step-heading" tabindex="-1">Mau paket yang mana?</h3>
        <div class="loading" data-services-loading>Memuat daftar paket…</div>
        <div data-services hidden></div>
      </div>

      <div data-step="time" hidden>
        <h3 class="step-heading" tabindex="-1">Kapan?</h3>
        <p class="chosen ui" data-chosen-service></p>
        <div class="loading" data-times-loading hidden>Memuat jadwal…</div>
        <div data-days class="days scroll-x"></div>
        <div data-times class="times"></div>
        <p class="muted empty" data-times-empty hidden>
          Tidak ada jam kosong di tanggal ini. Coba tanggal lain.
        </p>
        <button type="button" class="btn link ui" data-back="service">← Ganti paket</button>
      </div>

      <div data-step="details" hidden>
        <h3 class="step-heading" tabindex="-1">Data kamu</h3>
        <p class="chosen ui" data-chosen-slot></p>

        {/*
          A real form element, so Enter submits and a browser's own validation
          runs before any of ours does. The submit handler is what actually sends
          it — there is no server to post a form body to, and the API refuses
          anything that is not application/json precisely so that a form from
          another origin cannot reach it.
        */}
        <form data-form novalidate>
          <p class="field">
            <label for="nama">Nama</label>
            <input id="nama" name="nama" type="text" autocomplete="name" required />
          </p>
          <p class="field">
            <label for="wa">No WhatsApp</label>
            <input
              id="wa"
              name="wa"
              type="tel"
              inputmode="tel"
              autocomplete="tel"
              placeholder="08xxxxxxxxxx"
              required
            />
            <span class="hint muted">Untuk konfirmasi dan pengiriman link foto.</span>
          </p>
          <p class="field">
            <label for="email">Email <span class="muted">(opsional)</span></label>
            <input id="email" name="email" type="email" autocomplete="email" />
          </p>
          <p class="field">
            <label for="orang">Jumlah orang</label>
            <select id="orang" name="orang" data-headcount required></select>
          </p>

          {/*
            Which wall the room is dressed in, filled from the package's own list
            and hidden entirely for the packages that offer no choice — a photobox
            backdrop is part of the booth, and a picker with nothing in it is a
            question a customer stops to read before finding there is no answer to
            give.

            A select rather than radio swatches. The walls do not change what is
            free, so putting it before the calendar would add a page between "which
            package" and "when" for a choice that constrains neither. What the walls
            actually look like — the two motif walls — are shown as full photographs
            on the package cards in step one.
          */}
          <p class="field" data-backdrop hidden>
            <label for="background">Background</label>
            <span class="hint muted">Yang kamu pilih akan disiapkan sebelum sesi mulai.</span>
            <select id="background" name="background" data-backdrop-options required>
              <option value="">Pilih background</option>
            </select>
          </p>

          <div class="terms">
            <p class="ui">Syarat dan ketentuan</p>
            <ul>
              <li>Datang sesuai jam yang dipilih. Kalau butuh persiapan, datang lebih awal.</li>
              {terms.map((t) => <li>{t}</li>)}
              <li>Wajib menjaga kebersihan dan properti studio.</li>
            </ul>
            <p class="field check">
              <input id="setuju" name="setuju" type="checkbox" required />
              <label for="setuju">Saya setuju dengan syarat dan ketentuan di atas.</label>
            </p>
          </div>

          {/*
            aria-live so a screen reader hears a rejection. Errors here are not
            all validation — "that time was just taken" arrives from the server
            after everything on this form was filled in correctly.
          */}
          <p class="error" data-error role="status" aria-live="polite" hidden></p>

          <div class="actions">
            <button type="button" class="btn link ui" data-back="time">← Ganti jam</button>
            <button type="submit" class="btn primary ui" data-submit>Konfirmasi booking</button>
          </div>
        </form>
      </div>

      <div data-step="done" hidden>
        <h3 class="step-heading" tabindex="-1">Booking terkonfirmasi</h3>
        <div class="card receipt" data-receipt></div>
        <p class="muted">
          Simpan halaman ini atau catat kode booking-nya. Kalau perlu mengubah jadwal,
          {waHref ? <a href={waHref} rel="noopener"> chat admin</a> : " chat admin"} lebih
          dari 6 jam sebelum jam sesi.
        </p>
        <div class="actions">
          <a class="btn secondary ui" data-gcal target="_blank" rel="noopener">
            Simpan ke Google Calendar
          </a>
          {mapsUrl && (
            <a class="btn secondary ui" href={mapsUrl} target="_blank" rel="noopener">
              Lihat lokasi
            </a>
          )}
        </div>
      </div>
    </div>
  </section>

  {/*
    No price list under the flow.

    There was one — the same component the home page uses, rendering the whole
    catalogue as crawlable text. It was here on the argument that a page selling
    packages should state its prices without JavaScript. It said them twice
    instead: every package above, with a photograph and a price and a button,
    and then every package again below, with a photograph and a price and
    nothing to press. A visitor who had just been asked "mau paket yang mana?"
    scrolled into a second answer to the same question.

    Nothing crawlable is lost. `/` carries the identical component under the
    same `#harga` anchor, and it is the page a search engine ranks for the
    catalogue anyway; the fallback above now points there.
  */}
</BaseLayout>

{/*
  is:inline with set:html, the same shape as BaseLayout's reveal observer: a
  bundled script is a deferred module, and this one has work to start as soon as
  the section exists.

  The API base is interpolated into the source rather than passed with
  `define:vars`. The two do not compose — `define:vars` emits its own IIFE and
  discards the `set:html` body entirely, which produced a script containing one
  const and nothing else. JSON.stringify because this value ends up inside a
  script and a build-time string has no business being pasted in raw.
*/}
<script
  is:inline
  set:html={`(() => {
  var apiBase = ${JSON.stringify(apiBase)};
  // Interpolated rather than passed through define:vars, which Astro discards on
  // a set:html script. Empty when the vertical has no number recorded, and the
  // chat packages are then simply not rendered — a dead WhatsApp link is worse
  // than an absent one.
  var waNumber = ${JSON.stringify(whatsapp ?? "")};
  var waName = ${JSON.stringify(vertical.displayName)};

  var flow = document.querySelector("[data-flow]");
  if (!flow) return;

  var idr = new Intl.NumberFormat("id-ID", { style: "currency", currency: "IDR", maximumFractionDigits: 0 });

  // The heading above each block of packages, keyed by the block rather than by
  // the service_line the API sends — the two stopped being the same thing when
  // the patterned-backdrop packages got a heading of their own.
  //
  // The last two are unreachable today: everything on those lines is sold by
  // chat and rendered by renderChatPackages below. They stay so that a package
  // moved to "web" mode lands under a name rather than under its raw line.
  var GROUPS = {
    "self-basic": "Self Photo Basic",
    "self-motif": "Self Photo Motif",
    "photobox": "Photobox",
    "pas-foto": "Pas foto",
    "outdoor-photographer": "Fotografer luar studio",
    "videographer": "Videografer",
  };

  // Which block a package belongs under. Every line but self photo is already one
  // block; self photo is two, and the split is made here rather than in the API
  // because service_line is a CHECK constraint in SQLite — growing one means
  // rebuilding a table that every booking holds a foreign key into, which
  // 0004_booking.sql and the seed's own comment both spell out.
  //
  // The id prefix is the only signal the response carries, and it is a dependable
  // one: all three patterned packages are seeded as motif-… and nothing else is.
  function groupOf(s) {
    if (s.service_line !== "self-photo") return s.service_line;
    return s.id.indexOf("motif-") === 0 ? "self-motif" : "self-basic";
  }

  // The quoted packages that happen inside the studio, by id, because the line
  // they carry cannot say so: the seed files fotografer-studio under
  // outdoor-photographer for the same CHECK-constraint reason as above, and
  // says outright that nothing renders that value. Something does now.
  //
  // The API serves none of these today, which is why the indoor heading below
  // announces rather than lists. The moment the seed's studio session is live it
  // lands under that heading as a real card and the placeholder stops rendering,
  // rather than sitting under "outdoor" beside a "segera hadir" that contradicts it.
  var INDOOR_CHAT = { "fotografer-studio": true };

  var DAYS =["Min", "Sen", "Sel", "Rab", "Kam", "Jum", "Sab"];
  var MONTHS = ["Jan", "Feb", "Mar", "Apr", "Mei", "Jun", "Jul", "Agu", "Sep", "Okt", "Nov", "Des"];

  // The photograph on each package card, so somebody choosing between two
  // packages can see the room behind the price. The prices and headcounts never
  // said that; only a word in a description did.
  //
  // Keyed by service id but named after the room, because a room is what the
  // picture is of and two packages can share one: BIG MAXI is sold in the same
  // plain-backdrop room as MAXI, so its card borrows the photograph of its
  // smaller sibling rather than go without.
  //
  // The three motif packages have no entry, and that is the one deliberate gap.
  // Their block prints both patterned walls at full size under its heading, so a
  // thumbnail on each card is those same two photographs a second time at 88px —
  // where a pattern is not legible anyway, and where MOTIF FAMILY and MOTIF
  // SQUAD would have had to show the same crop as each other. See BACKDROPS.
  //
  // The photographer and videographer packages have no entry either. Nothing has
  // been shot of work away from the studio, and the nearest photograph in any
  // other line would be a picture of a room those packages do not happen in.
  var SHOTS = {
    "self-basic-mini": "Contoh hasil di ruang self photo latar polos",
    "self-basic-midi": "Contoh hasil di ruang self photo latar polos",
    "self-basic-maxi": "Contoh hasil di ruang self photo latar polos",
    "motif-black-molding": "Contoh hasil di ruang self photo latar motif Black Molding",
    "motif-mediteranian": "Contoh hasil di ruang self photo latar motif Mediteranian",
    "photobox-y2k": "Contoh hasil di bilik Photobox Y2K",
    "photobox-vintage": "Contoh hasil di bilik Photobox Vintage",
    "photobox-maroon": "Contoh hasil di bilik Photobox Maroon",
    "pas-formal": "Contoh hasil pas foto formal di empat warna latar",
    "pas-marry-me": "Contoh hasil pas foto pasangan berlatar biru",
    "pas-kedinasan": "Contoh hasil pas foto pasangan berseragam dinas berlatar kuning",
  };
  var THUMBS = {
    "self-mini": "self-basic-mini",
    "self-midi": "self-basic-midi",
    "self-maxi": "self-basic-maxi",
    "self-big-maxi": "self-basic-maxi",
    "photobox-y2k": "photobox-y2k",
    "photobox-vintage": "photobox-vintage",
    "photobox-maroon": "photobox-maroon",
    "pas-formal": "pas-formal",
    "pas-marry-me": "pas-marry-me",
    "pas-kedinasan": "pas-kedinasan",
  };

  // The two walls the motif room is dressed in, shown once under the heading
  // rather than described in words. "Background motif" is what the packages said
  // and it is not a picture of anything — a visitor weighing MIDI at 70K against
  // MOTIF MIDI at 80K is paying for a wall, so the wall is the thing to show.
  //
  // Once, and here: this is the only place the two appear, which is why the
  // three cards below carry no thumbnail. The alt text comes out of SHOTS, so
  // each photograph still keeps one description.
  var BACKDROPS = [
    { shot: "motif-black-molding", name: "Black Molding" },
    { shot: "motif-mediteranian", name: "Mediteranian" },
  ];

  // Returns markup because the cards around it are built that way, but the
  // element is assembled rather than concatenated: esc() below escapes for text
  // content and leaves a double quote alone, which is the wrong tool for an alt
  // attribute. outerHTML escapes what an attribute needs.
  //
  // loading="lazy" because the whole list arrives after a fetch and most of it
  // is below the fold; the dimensions are the file's own, so a row keeps its
  // height while the picture is still coming and the list does not jump.
  function thumb(id) {
    var shot = THUMBS[id];
    if (!shot) return "";
    var img = document.createElement("img");
    img.className = "pick-thumb";
    img.setAttribute("src", "/img/paket/" + shot + ".jpg");
    img.alt = SHOTS[shot];
    img.width = 264;
    img.height = 264;
    img.loading = "lazy";
    img.decoding = "async";
    return img.outerHTML;
  }

  // Assembled rather than concatenated, for the same reason thumb() is: esc()
  // escapes for text content and leaves a double quote alone, which is the wrong
  // tool for an alt attribute.
  //
  // A list rather than two loose figures, so the pair reads as "the room comes in
  // these two" — the same shape as the .picks list under it, at the size of a
  // thing you look at rather than a thing you scan past.
  function renderBackdrops(host) {
    var ul = document.createElement("ul");
    ul.className = "backdrops";
    BACKDROPS.forEach(function (b) {
      var li = document.createElement("li");
      var img = document.createElement("img");
      img.setAttribute("src", "/img/paket/" + b.shot + ".jpg");
      img.alt = SHOTS[b.shot];
      img.width = 264;
      img.height = 264;
      img.loading = "lazy";
      img.decoding = "async";
      var name = document.createElement("span");
      name.className = "backdrop-name ui";
      name.textContent = b.name;
      li.appendChild(img);
      li.appendChild(name);
      ul.appendChild(li);
    });
    host.appendChild(ul);
  }

  var el = function (sel) { return flow.querySelector(sel); };
  var steps = {
    service: el('[data-step="service"]'),
    time: el('[data-step="time"]'),
    details: el('[data-step="details"]'),
    done: el('[data-step="done"]'),
  };
  var crumbs = flow.querySelectorAll("[data-crumbs] li");
  var order = ["service", "time", "details"];

  var state = { service: null, slots: {}, day: null, slot: null, backdrop: null };

  function show(name) {
    for (var k in steps) steps[k].hidden = k !== name;
    var at = order.indexOf(name);
    for (var i = 0; i < crumbs.length; i++) {
      crumbs[i].toggleAttribute("aria-current", i === at);
      crumbs[i].classList.toggle("done", at > -1 && i < at);
    }
    flow.querySelector("[data-crumbs]").hidden = name === "done";
    // Focus the heading rather than scrolling the window: a keyboard or screen
    // reader user who picked a package needs to land on the next question, not be
    // left at the top of a section whose contents silently changed.
    var h = steps[name].querySelector(".step-heading");
    if (h) h.focus({ preventScroll: true });
    steps[name].scrollIntoView({ block: "nearest", behavior: "smooth" });
  }

  function fail(message) {
    var box = el("[data-error]");
    box.textContent = message;
    box.hidden = false;
  }

  function clearError() {
    var box = el("[data-error]");
    box.hidden = true;
    box.textContent = "";
  }

  // ---- step 1: the packages, from whatever the API says is bookable ----------

  fetch(apiBase + "/v1/booking/services")
    .then(function (r) { if (!r.ok) throw new Error(r.status); return r.json(); })
    .then(function (data) { renderServices(data.services || []); })
    .catch(function () {
      el("[data-services-loading]").textContent =
        "Daftar paket sedang tidak bisa dimuat. Silakan chat admin lewat WhatsApp.";
    });

  function renderServices(all) {
    // Two kinds of package, and they cannot share a renderer: one leads to a
    // calendar, the other to a conversation.
    var services = [];
    var chat = [];
    all.forEach(function (s) { (s.booking_mode === "chat" ? chat : services).push(s); });

    if (!services.length && !chat.length) {
      el("[data-services-loading]").textContent =
        "Belum ada paket yang bisa dibooking online. Silakan chat admin lewat WhatsApp.";
      return;
    }

    var host = el("[data-services]");
    var groups = [];
    var seen = {};
    services.forEach(function (s) {
      var g = groupOf(s);
      if (!seen[g]) { seen[g] = []; groups.push(g); }
      seen[g].push(s);
    });

    groups.forEach(function (group) {
      var h = document.createElement("h4");
      h.textContent = GROUPS[group] || group;
      host.appendChild(h);

      // Under the heading rather than on the cards, and instead of them: at 88px
      // a thumbnail shows that a wall is patterned and not what the pattern is,
      // which is the one thing this block is selling. What separates the three
      // packages under it is how many people fit, not which wall.
      if (group === "self-motif") renderBackdrops(host);

      var ul = document.createElement("ul");
      ul.className = "picks";
      seen[group].forEach(function (s) {
        var li = document.createElement("li");
        var b = document.createElement("button");
        b.type = "button";
        b.className = "card pick";
        b.innerHTML =
          thumb(s.id) +
          '<span class="pick-body">' +
          '<span class="pick-name">' + esc(s.name) + "</span>" +
          '<span class="pick-price tabular">' + idr.format(s.price_idr) +
          (s.price_per_person ? '<span class="muted"> / orang</span>' : "") + "</span>" +
          '<span class="pick-spec muted ui tabular">' + s.duration_minutes + " menit · " +
          (s.headcount_min === s.headcount_max
            ? s.headcount_max + " orang"
            : s.headcount_min + "–" + s.headcount_max + " orang") + "</span>" +
          (s.description ? '<span class="pick-desc muted">' + esc(s.description) + "</span>" : "") +
          "</span>";
        b.addEventListener("click", function () { chooseService(s); });
        li.appendChild(b);
        ul.appendChild(li);
      });
      host.appendChild(ul);
    });

    renderChatPackages(host, chat);

    el("[data-services-loading]").hidden = true;
    host.hidden = false;
  }

  // Packages the studio quotes rather than sells: a photographer session is
  // priced off where, how long and how many people, so the page's job is to
  // start that conversation rather than to take a slot against a number nobody
  // has agreed. Anchors, not buttons — this leaves the page.
  //
  // No duration or headcount line here, unlike a bookable package. Those numbers
  // are what a session promises once it is agreed, and printing "60 menit"
  // beside a package with no price reads as a quote.
  //
  // Two headings rather than one. Every package the studio quotes today happens
  // at the customer's location, and a bare "Fotografer & videografer" over a
  // column of prices left a visitor to work out on their own whether 350K bought
  // an hour in the studio. It does not, and the in-studio pair is not on sale
  // yet — so the heading says outdoor and the indoor pair is announced below it.
  function renderChatPackages(host, chat) {
    var indoor = [];
    var outdoor = [];
    chat.forEach(function (s) { (INDOOR_CHAT[s.id] ? indoor : outdoor).push(s); });

    function heading(text) {
      var h = document.createElement("h4");
      h.textContent = text;
      host.appendChild(h);
    }

    function note(text) {
      var p = document.createElement("p");
      p.className = "muted chat-note";
      p.textContent = text;
      host.appendChild(p);
    }

    if (outdoor.length && waNumber) {
      heading("Fotografer & videografer outdoor");
      note("Paket ini diatur lewat chat — jadwal dan harga menyesuaikan lokasi, durasi dan jumlah orang.");
      host.appendChild(chatList(outdoor));
    }

    if (indoor.length) {
      // Nothing to announce: the studio is selling it. Same treatment as the
      // outdoor block, and silently absent when there is no number to chat to,
      // because a dead WhatsApp link is worse than an absent one.
      if (!waNumber) return;
      heading("Fotografer & videografer indoor");
      note("Paket ini diatur lewat chat — jadwal dan harga menyesuaikan durasi dan jumlah orang.");
      host.appendChild(chatList(indoor));
      return;
    }

    heading("Fotografer & videografer indoor");
    host.appendChild(soonList(["Fotografer indoor", "Videografer indoor"]));
  }

  function chatList(services) {
    var ul = document.createElement("ul");
    ul.className = "picks";
    services.forEach(function (s) {
      var li = document.createElement("li");
      var a = document.createElement("a");
      a.className = "card pick pick-chat";
      a.href = "https://wa.me/" + waNumber + "?text=" +
        encodeURIComponent("Halo " + waName + ", saya mau tanya paket " + s.name + ".");
      a.rel = "noopener";
      // Wrapped in .pick-body like the bookable cards even though there is no
      // photograph to sit beside: .pick lays its children out in a row now, so a
      // card whose spans were direct children would print its name, price and
      // description side by side.
      a.innerHTML =
        '<span class="pick-body">' +
        '<span class="pick-name">' + esc(s.name) + "</span>" +
        '<span class="pick-price tabular">' +
        (s.price_idr > 0
          ? idr.format(s.price_idr) + (s.price_per_person ? '<span class="muted"> / orang</span>' : "")
          : '<span class="muted">Harga via chat</span>') + "</span>" +
        (s.description ? '<span class="pick-desc muted">' + esc(s.description) + "</span>" : "") +
        '<span class="pick-spec muted ui">Chat admin di WhatsApp →</span>' +
        "</span>";
      li.appendChild(a);
      ul.appendChild(li);
    });
    return ul;
  }

  // Announced, not sold. The card is a plain <li> with no price, no link and no
  // description: there is nothing here to press, and a WhatsApp link would start
  // a conversation the studio cannot yet finish. No duration or headcount either,
  // for the reason the chat cards carry none — a number beside a package with no
  // price reads as a quote, and these have not been priced at all.
  function soonList(names) {
    var ul = document.createElement("ul");
    ul.className = "picks";
    names.forEach(function (name) {
      var li = document.createElement("li");
      li.className = "card pick pick-soon";
      li.innerHTML =
        '<span class="pick-body">' +
        '<span class="pick-name">' + esc(name) + "</span>" +
        '<span class="pick-spec muted ui">Segera hadir</span>' +
        "</span>";
      ul.appendChild(li);
    });
    return ul;
  }

  function esc(s) {
    var d = document.createElement("div");
    d.textContent = s;
    return d.innerHTML;
  }

  // ---- step 2: the calendar --------------------------------------------------

  function chooseService(service) {
    state.service = service;
    state.day = null;
    state.slot = null;
    el("[data-chosen-service]").textContent =
      service.name + " · " + idr.format(service.price_idr) + (service.price_per_person ? " / orang" : "");
    fillHeadcount(service);
    fillBackdrops(service);
    show("time");
    loadAvailability(service);
  }

  function fillHeadcount(service) {
    var sel = el("[data-headcount]");
    sel.innerHTML = "";
    for (var n = service.headcount_min; n <= service.headcount_max; n++) {
      var o = document.createElement("option");
      o.value = String(n);
      o.textContent = n + " orang";
      sel.appendChild(o);
    }
  }

  // The walls this package can be shot against, exactly as the API ordered them —
  // pas foto leads with the two an Indonesian identity photo actually calls for,
  // and that ordering is a fact the server holds, not one to re-sort here.
  //
  // Names and not colour chips. Guessing a hex for "Duck Egg" would show a
  // customer a colour that is not the paper in the building, and the sites are
  // monochrome by design — six swatches would be the only hue on four properties.
  // The two motif walls are not pictured in the select either: they are printed
  // full size under their own heading in step one.
  function fillBackdrops(service) {
    var field = el("[data-backdrop]");
    var sel = el("[data-backdrop-options]");
    sel.innerHTML = '<option value="">Pilih background</option>';
    state.backdrop = null;

    var options = service.backdrops || [];
    field.hidden = options.length === 0;
    if (!options.length) return;

    options.forEach(function (b) {
      var o = document.createElement("option");
      o.value = b.id;
      o.textContent = b.name;
      sel.appendChild(o);
    });

    sel.addEventListener("change", function onChange() {
      var id = sel.value;
      state.backdrop = id ? options.find(function (b) { return b.id === id; }) : null;
      clearError();
      sel.removeEventListener("change", onChange);
    }, { once: true });
  }

  function needsBackdrop() {
    return !!(state.service && (state.service.backdrops || []).length);
  }

  function loadAvailability(service) {
    var days = el("[data-days]");
    var times = el("[data-times]");
    days.innerHTML = "";
    times.innerHTML = "";
    el("[data-times-empty]").hidden = true;
    el("[data-times-loading]").hidden = false;

    // One request for the whole window rather than one per day. The window is 31
    // days, the response is cached at the edge for a minute, and it means picking
    // through dates costs nothing after the first load — a booking is abandoned
    // by waiting, not by bytes.
    var from = new Date();
    var to = new Date(from.getTime() + 31 * 86400000);

    fetch(apiBase + "/v1/booking/availability?service=" + encodeURIComponent(service.id) +
      "&from=" + ymd(from) + "&to=" + ymd(to))
      .then(function (r) { if (!r.ok) throw new Error(r.status); return r.json(); })
      .then(function (data) {
        el("[data-times-loading]").hidden = true;
        state.slots = groupByDay(data.slots || []);
        renderDays();
      })
      .catch(function () {
        el("[data-times-loading]").hidden = true;
        el("[data-times-empty]").hidden = false;
        el("[data-times-empty]").textContent =
          "Jadwal sedang tidak bisa dimuat. Silakan coba lagi atau chat admin.";
      });
  }

  // The server sends WIB with its offset, and the studio's day is a local fact —
  // so the day a slot belongs to is taken from the string it arrived in rather
  // than from a Date, which would file a 20:30 slot under tomorrow for anyone
  // whose phone is set to Jakarta+2.
  function groupByDay(slots) {
    var out = {};
    slots.forEach(function (s) {
      var day = s.starts_at.slice(0, 10);
      (out[day] = out[day] || []).push(s);
    });
    return out;
  }

  function ymd(d) {
    return d.getFullYear() + "-" + pad(d.getMonth() + 1) + "-" + pad(d.getDate());
  }
  function pad(n) { return n < 10 ? "0" + n : String(n); }

  function renderDays() {
    var host = el("[data-days]");
    host.innerHTML = "";
    var days = Object.keys(state.slots).sort();
    if (!days.length) {
      el("[data-times-empty]").hidden = false;
      el("[data-times-empty]").textContent = "Belum ada jam kosong untuk paket ini.";
      return;
    }
    days.forEach(function (day) {
      var parts = day.split("-");
      var d = new Date(Number(parts[0]), Number(parts[1]) - 1, Number(parts[2]));
      var b = document.createElement("button");
      b.type = "button";
      b.className = "day";
      b.innerHTML =
        '<span class="day-name ui">' + DAYS[d.getDay()] + "</span>" +
        '<span class="day-num tabular">' + d.getDate() + "</span>" +
        '<span class="day-mon muted ui">' + MONTHS[d.getMonth()] + "</span>";
      b.addEventListener("click", function () { chooseDay(day); });
      host.appendChild(b);
    });
    chooseDay(days[0]);
  }

  function chooseDay(day) {
    state.day = day;
    var host = el("[data-days]");
    var buttons = host.querySelectorAll(".day");
    var days = Object.keys(state.slots).sort();
    for (var i = 0; i < buttons.length; i++) {
      buttons[i].setAttribute("aria-pressed", String(days[i] === day));
    }
    renderTimes();
  }

  function renderTimes() {
    var host = el("[data-times]");
    host.innerHTML = "";
    var slots = state.slots[state.day] || [];
    el("[data-times-empty]").hidden = slots.length > 0;
    slots.forEach(function (s) {
      var b = document.createElement("button");
      b.type = "button";
      b.className = "time tabular";
      b.textContent = s.starts_at.slice(11, 16);
      b.addEventListener("click", function () { chooseSlot(s); });
      host.appendChild(b);
    });
  }

  // ---- step 3: the form ------------------------------------------------------

  function chooseSlot(slot) {
    state.slot = slot;
    clearError();
    var parts = slot.starts_at.slice(0, 10).split("-");
    var d = new Date(Number(parts[0]), Number(parts[1]) - 1, Number(parts[2]));
    el("[data-chosen-slot]").textContent =
      state.service.name + " · " + DAYS[d.getDay()] + " " + d.getDate() + " " +
      MONTHS[d.getMonth()] + " · " + slot.starts_at.slice(11, 16) +
      "–" + slot.ends_at.slice(11, 16);
    show("details");
  }

  flow.querySelectorAll("[data-back]").forEach(function (b) {
    b.addEventListener("click", function () { show(b.getAttribute("data-back")); });
  });

  el("[data-form]").addEventListener("submit", function (ev) {
    ev.preventDefault();
    clearError();

    var form = ev.target;
    var nama = form.nama.value.trim();
    var wa = form.wa.value.trim();

    if (!nama) return fail("Nama wajib diisi.");
    // Loose on purpose: internal/phone owns what a valid Indonesian mobile number
    // is, and a stricter guess here would refuse numbers the server accepts.
    if (wa.replace(/[^0-9]/g, "").length < 9) return fail("Nomor WhatsApp belum lengkap.");
    // Caught here rather than defaulted, and the server refuses it too — the page
    // is not the only thing that can post a booking.
    if (needsBackdrop() && !state.backdrop) return fail("Pilih background dulu.");
    if (!form.setuju.checked) return fail("Syarat dan ketentuan harus disetujui.");

    var button = el("[data-submit]");
    button.disabled = true;
    button.textContent = "Mengirim…";

    fetch(apiBase + "/v1/booking", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        service: state.service.id,
        starts_at: state.slot.starts_at,
        headcount: Number(form.orang.value),
        name: nama,
        phone: wa,
        email: form.email.value.trim(),
        // Empty for a package with no choice, which is what the server expects —
        // it refuses a wall named for a booth that has one built in.
        backdrop: state.backdrop ? state.backdrop.id : "",
        terms: true,
      }),
    })
      .then(function (r) {
        return r.json().then(function (body) { return { ok: r.ok, status: r.status, body: body }; });
      })
      .then(function (res) {
        button.disabled = false;
        button.textContent = "Konfirmasi booking";
        if (res.ok) return done(res.body);

        fail(res.body && res.body.error ? res.body.error : "Booking gagal. Silakan coba lagi.");
        // 409 is somebody else getting there first, which is the one failure where
        // the form is not the problem. Reload the grid and send them back to it,
        // rather than leaving a filled-in form pointing at a slot that is gone.
        if (res.status === 409) {
          loadAvailability(state.service);
          show("time");
        }
      })
      .catch(function () {
        button.disabled = false;
        button.textContent = "Konfirmasi booking";
        fail("Tidak bisa menghubungi server. Periksa koneksi lalu coba lagi.");
      });
  });

  // ---- step 4: the receipt ---------------------------------------------------

  function done(booking) {
    var parts = booking.starts_at.slice(0, 10).split("-");
    var d = new Date(Number(parts[0]), Number(parts[1]) - 1, Number(parts[2]));
    var when = DAYS[d.getDay()] + ", " + d.getDate() + " " + MONTHS[d.getMonth()] + " " +
      d.getFullYear() + " · " + booking.starts_at.slice(11, 16);

    // The server's word for it, not the chip that was clicked: this line is the
    // customer's record of what the studio agreed to hang, and the only authority
    // on that is the row that was written. Absent for a package with no choice.
    var background = booking.backdrop
      ? "<dt class=\\"muted\\">Background</dt><dd>" + esc(booking.backdrop) + "</dd>"
      : "";

    el("[data-receipt]").innerHTML =
      '<p class="receipt-when">' + esc(when) + "</p>" +
      '<dl class="spec ui tabular">' +
      "<dt class=\\"muted\\">Paket</dt><dd>" + esc(state.service.name) + "</dd>" +
      background +
      "<dt class=\\"muted\\">Nama</dt><dd>" + esc(booking.name) + "</dd>" +
      "<dt class=\\"muted\\">Jumlah</dt><dd>" + booking.headcount + " orang</dd>" +
      "<dt class=\\"muted\\">WhatsApp</dt><dd>" + esc(booking.phone) + "</dd>" +
      "<dt class=\\"muted\\">Kode</dt><dd>" + esc(booking.id.slice(0, 8)) + "</dd>" +
      "</dl>";

    var link = el("[data-gcal]");
    if (link) link.href = gcalUrl(booking, state.service);
    show("done");
  }

  // Also in the customer's own calendar entry, because the studio's copy carries
  // it and the two should say the same thing — somebody who booked three weeks
  // ago will not remember which wall they picked.
  function backgroundLine(booking) {
    return booking.backdrop ? "\\nBackground: " + booking.backdrop : "";
  }

  // The customer's own copy. The studio's calendar is written by the server; this
  // is the other half — a link, because it needs no permission from anybody and
  // works on a phone that has Google Calendar installed.
  function gcalUrl(booking, service) {
    var start = new Date(booking.starts_at);
    var end = new Date(booking.ends_at);
    var stamp = function (d) {
      return d.getUTCFullYear() + pad(d.getUTCMonth() + 1) + pad(d.getUTCDate()) + "T" +
        pad(d.getUTCHours()) + pad(d.getUTCMinutes()) + "00Z";
    };
    var q = new URLSearchParams({
      action: "TEMPLATE",
      text: service.name + " — studio by KAMI",
      dates: stamp(start) + "/" + stamp(end),
      details: "Kode booking: " + booking.id.slice(0, 8) + "\\nAtas nama " + booking.name +
        " (" + booking.headcount + " orang)" + backgroundLine(booking),
      location: "studio by KAMI, Jalan Yos Sudarso, Jajag Barat, Banyuwangi",
    });
    return "https://calendar.google.com/calendar/render?" + q.toString();
  }
})();`}
/>

<style>
  .hero {
    margin-block: var(--space-12) var(--space-section);
  }

  .lede {
    font-size: 18px;
    color: var(--muted);
  }

  /* Swapped by the `js` class BaseLayout sets in <head>, before first paint. */
  .flow {
    display: none;
  }

  :global(html.js) .flow {
    display: block;
  }

  :global(html.js) .fallback {
    display: none;
  }

  [hidden] {
    display: none !important;
  }

  .step-heading {
    font-size: 24px;
    line-height: 1.4;
    letter-spacing: -0.04em;
    margin-bottom: var(--space-4);
  }

  /* Outline suppressed only because focus here is moved programmatically to
     announce the step, not because the user tabbed to it. */
  .step-heading:focus {
    outline: none;
  }

  .crumbs {
    display: flex;
    gap: var(--space-3);
    list-style: none;
    margin: 0 0 var(--space-6);
    padding: 0;
    color: var(--faint);
  }

  .crumbs li::before {
    content: "";
    display: inline-block;
    width: 6px;
    height: 6px;
    margin-right: var(--space-2);
    border-radius: 50%;
    background: currentColor;
    vertical-align: middle;
  }

  .crumbs li[aria-current] {
    color: var(--text);
  }

  .crumbs .done {
    color: var(--muted);
  }

  /*
   * Everything below here is written as `:global([data-flow] …)`, and it has to
   * be.
   *
   * Astro scopes a component's styles by stamping `data-astro-cid-…` on the
   * elements in its template and adding that attribute to every selector. The
   * package cards, the day strip and the time chips are built by the script
   * above with `createElement`, so they never receive the attribute and every
   * scoped rule aimed at them silently does nothing — which is exactly what
   * happened: the day chips rendered as one run of inline text with a default
   * button border.
   *
   * `[data-flow]` is the namespace that replaces the scoping. It is on the
   * flow's own container and nowhere else in the repo, so `.day` and `.time` —
   * names generic enough to collide — cannot reach anything outside this page.
   */
  :global([data-flow] h4) {
    margin-block: var(--space-6) var(--space-3);
  }

  :global([data-flow] .picks) {
    display: grid;
    gap: var(--space-3);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  @media (min-width: 640px) {
    :global([data-flow] .picks) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  :global([data-flow] .pick) {
    display: flex;
    gap: var(--space-4);
    align-items: flex-start;
    width: 100%;
    padding: var(--space-4);
    text-align: left;
    background: var(--surface);
    cursor: pointer;
    font: inherit;
    color: inherit;
  }

  :global([data-flow] .pick-body) {
    display: grid;
    gap: var(--space-1);
    /* The name, price and spec are the card; without this the flex item refuses
       to shrink past its longest word and a long package name pushes the
       thumbnail out of the padding. */
    min-width: 0;
  }

  /* Square, and the same square on every card whatever shape the photograph
     started as — a picker whose rows are different heights reads as a list of
     unrelated things rather than a range to choose from. The files are cropped
     square already; object-fit is the guard, not the mechanism. */
  :global([data-flow] .pick-thumb) {
    flex: 0 0 auto;
    width: 88px;
    height: 88px;
    border-radius: calc(var(--radius) - var(--space-2));
    object-fit: cover;
    background: var(--line);
  }

  /* .pick-soon excluded: it is an <li>, not a button or an anchor, and a card
     that lights up under the cursor without going anywhere reads as broken. */
  :global([data-flow] .pick:not(.pick-soon):hover) {
    border-color: var(--text);
  }

  :global([data-flow] .pick-name) {
    font-weight: 600;
  }

  :global([data-flow] .pick-price) {
    font-size: 18px;
  }

  /* The chat packages are anchors wearing the same card as the buttons beside
     them, so the underline a link would otherwise carry has to come off. */
  :global([data-flow] .pick-chat) {
    text-decoration: none;
  }

  :global([data-flow] .pick-chat .pick-spec) {
    margin-top: var(--space-1);
  }

  /* Announced, not sold: no pointer, and no hover border, because neither
     promises anything a click would deliver. */
  :global([data-flow] .pick-soon) {
    cursor: default;
  }

  :global([data-flow] .pick-soon .pick-name) {
    color: var(--muted);
  }

  :global([data-flow] .chat-note) {
    margin: 0 0 var(--space-3);
  }

  /* The two motif backdrops, side by side at every width — the pair is the
     point, and one above the other is two photographs rather than a choice.

     The max-width is the two files at their own size with the gap between them.
     Without it each one stretches to half the section, which on a laptop is
     440px of a 264px JPEG: blurred, and taller than every card under it, so the
     block reads as a gallery with a price list attached. Narrower than that and
     they scale down, which costs nothing. */
  :global([data-flow] .backdrops) {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3);
    max-width: calc(2 * 264px + var(--space-3));
    list-style: none;
    margin: 0 0 var(--space-4);
    padding: 0;
  }

  :global([data-flow] .backdrops img) {
    display: block;
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: var(--radius);
    background: var(--line);
  }

  :global([data-flow] .backdrop-name) {
    display: block;
    margin-top: var(--space-2);
  }

  /* The day strip scrolls rather than wrapping: a month wrapped is a block of
     numbers, and a strip reads as a calendar the thumb can flick through. */
  .days {
    display: flex;
    gap: var(--space-2);
    margin-bottom: var(--space-6);
    padding-bottom: var(--space-2);
  }

  :global([data-flow] .day) {
    display: grid;
    flex: 0 0 auto;
    gap: 2px;
    justify-items: center;
    min-width: 56px;
    min-height: var(--tap);
    padding: var(--space-2);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    cursor: pointer;
    font: inherit;
    color: inherit;
  }

  :global([data-flow] .day-num) {
    font-size: 18px;
    font-weight: 600;
  }

  :global([data-flow] .day[aria-pressed="true"]) {
    border-color: var(--text);
    background: var(--text);
    color: var(--surface);
  }

  /* The muted month label has to stop being muted once the chip is inverted, or
     it disappears into the fill. */
  :global([data-flow] .day[aria-pressed="true"] .muted) {
    color: inherit;
  }

  .times {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  :global([data-flow] .time) {
    min-width: 72px;
    min-height: var(--tap);
    padding-inline: var(--space-3);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    cursor: pointer;
    font: inherit;
    color: inherit;
  }

  :global([data-flow] .time:hover) {
    border-color: var(--text);
  }

  .chosen {
    margin-bottom: var(--space-4);
    color: var(--muted);
  }

  .loading,
  .empty {
    color: var(--muted);
  }

  form {
    max-width: var(--measure);
  }

  .field {
    display: grid;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
    max-width: 28rem;
  }

  label {
    font-size: 14px;
    font-weight: 600;
  }

  input[type="text"],
  input[type="tel"],
  input[type="email"],
  select {
    min-height: var(--tap);
    padding-inline: var(--space-3);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--text);
    font: inherit;
    letter-spacing: inherit;
  }

  input:focus-visible,
  select:focus-visible {
    outline: 2px solid var(--text);
    outline-offset: 1px;
  }

  .hint {
    font-size: 14px;
  }

  /* A dropdown for background selection, matching the other form selects. Filled
     from the package's own list and hidden entirely for packages that offer no
     choice — a photobox backdrop is part of the booth. */
  :global([data-flow] [data-backdrop] select) {
    width: 100%;
    max-width: 28rem;
  }

  .check {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
  }

  .check label {
    font-weight: 400;
  }

  .check input {
    margin-top: 2px;
    width: 20px;
    height: 20px;
    flex: 0 0 auto;
  }

  .terms {
    margin-block: var(--space-6);
    padding: var(--space-4);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }

  .terms ul {
    margin: var(--space-2) 0 var(--space-4);
    padding-left: 1.25rem;
    color: var(--muted);
    font-size: 14px;
  }

  .terms li {
    margin-bottom: var(--space-1);
  }

  /* Ink, not red. The palette is monochrome by design — see tokens.css — and a
     single red would be the only hue on four sites. Weight and a rule carry it. */
  .error {
    margin-block: var(--space-4);
    padding: var(--space-3);
    border-left: 3px solid var(--text);
    background: rgb(244, 244, 244);
    font-weight: 600;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    align-items: center;
    margin-top: var(--space-6);
  }

  .btn {
    display: inline-flex;
