---
import { byId } from "@bykami/content";
import BaseLayout from "@bykami/ui/BaseLayout.astro";
import Faq from "@bykami/ui/Faq.astro";
import InstagramPosts from "@bykami/ui/InstagramPosts.astro";
import PriceList from "@bykami/ui/PriceList.astro";

/**
 * Still no menu source anywhere in the project, so `PriceList` renders nothing.
 * That is the intended behaviour — the page carries the location and the posts
 * rather than an empty menu table or invented dishes.
 */
const vertical = byId("dimsamcong");
---

<BaseLayout
  vertical={vertical}
  title="Dimsamcong Banyuwangi — dimsum dan makanan ringan"
  description="Dimsamcong, dimsum dan makanan ringan di Jajag, Banyuwangi. Satu lokasi dengan studio by KAMI."
>
  <section class="wrap hero">
    <h1>Dimsamcong Banyuwangi</h1>
    <p class="lede">{vertical.description}</p>
  </section>

  <PriceList vertical={vertical} heading="Menu" />

  <InstagramPosts vertical={vertical} />

  <Faq vertical={vertical} />
</BaseLayout>

<style>
  .hero {
    margin-block: var(--space-12) var(--space-section);
  }

  .lede {
    font-size: 18px;
    color: var(--muted);
  }
</style>
