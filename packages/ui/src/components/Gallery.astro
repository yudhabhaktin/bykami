---
import SectionHeader from "./SectionHeader.astro";

/**
 * A photo strip.
 *
 * The reference this borrows from is a photography site, and almost all of its
 * impact comes from the pictures rather than the layout — full-bleed, black and
 * white, asymmetric. A photo studio's page with no photographs on it is the
 * single largest gap here, larger than any amount of type scale.
 *
 * Renders nothing when no images are supplied, so clearing the grid is a matter
 * of passing an empty list rather than editing markup.
 */
interface Props {
  images: { src: string; alt: string }[];
  heading?: string;
  label?: string;
}

const { images, heading = "Galeri", label = "Foto" } = Astro.props;
---

{
  images.length > 0 && (
    <section id="galeri" class="wrap section">
      <SectionHeader heading={heading} label={label} />

      <ul class="grid">
        {images.map((img, i) => (
          /*
           * Each cell resolves on its own, and the box that clips the 10%
           * oversize is the one that already clips for the radius.
           *
           * The stagger runs across a row rather than down the whole list.
           * Cells are revealed individually as they come into view, so an
           * index-wide ramp would put a two-second delay on the twentieth
           * picture for no reason anyone could see; three steps of Chimera's
           * 70ms read as a left-to-right cascade on desktop and as an
           * alternation on the two-column phone layout.
           */
          <li class="cell" data-reveal-media style={`--reveal-delay: ${(i % 3) * 0.07}s`}>
            <img
              src={img.src}
              alt={img.alt}
              width="900"
              height="1125"
              /*
               * The first pair is close enough to the fold on a phone to be
               * worth fetching eagerly; the rest wait. `decoding="async"`
               * keeps a large JPEG off the main thread on the mid-range
               * Androids this site is built for.
               */
              loading={i < 2 ? "eager" : "lazy"}
              decoding="async"
            />
          </li>
        ))}
      </ul>
    </section>
  )
}

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .cell {
    margin: 0;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--line);
  }

  img {
    display: block;
    width: 100%;
    height: 100%;
    /*
     * 4:5, which is what Instagram serves and therefore what every picture in
     * here already is — so `cover` crops nothing. The box still decides the
     * ratio, the same discipline the booth preview uses; it just happens to
     * agree with the source, which is the cheapest kind of agreement to keep.
     */
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  @media (min-width: 640px) {
    .grid {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-4);
    }
  }
</style>
