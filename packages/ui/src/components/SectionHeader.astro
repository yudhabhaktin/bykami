---
/**
 * The heading block every section shares.
 *
 * Three parts, from the photography reference: the heading, an optional line of
 * supporting text, and a small labelled square that marks the section boundary.
 * A bare `<h2>` gives a crawler the same information but gives a reader no sense
 * that the page has structure, which is most of the difference between a page
 * that looks composed and one that looks transcribed.
 *
 * `lede` is deliberately optional and mostly unset. The reference fills it with
 * agency copy; the equivalent here would be sentences nobody has written and
 * that this repo has no business inventing on the owner's behalf. Where it is
 * absent the heading and the label share one row instead of leaving a gap.
 */
import Reveal from "./motion/Reveal";

interface Props {
  heading: string;
  /** Supporting sentence. Owner copy — leave unset rather than inventing it. */
  lede?: string;
  /** Short section label, e.g. "Harga". Factual, one or two words. */
  label?: string;
  id?: string;
}

const { heading, lede, label, id } = Astro.props;
---

{/*
  One island per section heading, which is what puts the Chimera reveal on every
  section of all four sites from a single edit — this component is the heading
  block each of them already shares.

  It wraps the whole header rather than animating the three parts separately.
  Chimera does stagger them, but its version of this block is three positioned
  nodes and this one is a grid whose columns are these exact children; wrapping
  each child would make the wrapper the grid item and hand the layout to the
  animation code. A section heading arriving as one block is the part of the
  effect worth having, and it costs no layout risk.

  `rootMargin` starts hydration 200px before the header is on screen. Without
  it, the chunk begins downloading at the moment the CSS is already hiding the
  header, and on the 3G end of this traffic that reads as a section that is
  briefly missing. The reveal itself still waits for 50% visibility.
*/}
<Reveal client:visible={{ rootMargin: "200px" }}>
  <header class:list={["head", !lede && "no-lede"]}>
    <h2 id={id}>{heading}</h2>
    {lede && <p class="lede muted">{lede}</p>}
    {label && <span class="eyebrow">{label}</span>}
  </header>
</Reveal>

<style>
  .head {
    display: grid;
    gap: var(--space-3);
    margin-bottom: var(--space-8);
  }

  h2 {
    margin: 0;
  }

  .lede {
    margin: 0;
    font-size: 18px;
    max-width: 42ch;
  }

  @media (min-width: 960px) {
    .head {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr) auto;
      align-items: start;
      gap: var(--space-8);
    }

    /*
     * The heading sets the row height, so the two small elements need nudging
     * down to sit against its first line rather than its box top.
     */
    .lede,
    .eyebrow {
      padding-top: 0.4em;
    }

    .head.no-lede {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: baseline;
    }

    .head.no-lede .eyebrow {
      padding-top: 0;
    }
  }
</style>
