---
import { pageLd, type Vertical } from "@bykami/content";
import Footer from "./Footer.astro";
import JsonLd from "./JsonLd.astro";
import Nav from "./Nav.astro";
import StickyBar from "./StickyBar.astro";
import "../tokens.css";

interface Props {
  vertical: Vertical;
  title?: string;
  description?: string;
  path?: string;
  trail?: { name: string; path: string }[];
}

const {
  vertical,
  title = `${vertical.displayName} — ${vertical.tagline}`,
  description = vertical.description,
  path = "/",
  trail = [],
} = Astro.props;

/**
 * Canonical always points at the final hostname, never at the preview host, so
 * the pages.dev deployment can never compete with the real domain once it lands.
 * Domain cutover is then a DNS change, not a content migration.
 */
const canonical = `https://${vertical.hostname}${path}`;

/**
 * Two gates, both of which must open. BYKAMI_INDEXABLE asks whether this build
 * is the real domain rather than a *.pages.dev preview; `vertical.indexable`
 * asks whether this property has content worth indexing. Either one defaulting
 * closed keeps a page out, which is the safe direction to fail.
 */
const indexable = import.meta.env["BYKAMI_INDEXABLE"] === "true" && vertical.indexable;

const blocks = pageLd(vertical, trail);
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    {/*
      Written into dist by the brandAssets integration, not held in each site's
      public/ — see packages/ui/src/brand.mjs. The manifest and the Apple title
      both exist to make the label under the icon read "by KAMI" rather than
      whatever this page's <title> happens to be.
    */}
    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="apple-mobile-web-app-title" content="by KAMI" />

    {!indexable && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="id_ID" />

    <link rel="sitemap" href="/sitemap-index.xml" />

    <JsonLd blocks={blocks} />

    {/*
      Marks the document as scripted, before first paint.

      tokens.css hides anything carrying `data-reveal` behind `.js`, so this one
      line is what decides whether a visitor sees an animated page or simply a
      visible one. It has to be inline and it has to be here: a deferred or
      bundled script runs after the first paint, which would show every reveal
      target at full opacity and then blink it away as the class landed.

      `set:html` because Astro would otherwise process this as a module and
      defer it, which is exactly the timing this needs to avoid.

      The font itself is no longer declared here. Its @font-face sits in
      tokens.css beside the --font-sans that names it, with a relative URL the
      bundler resolves — see fonts/README.md for why the rule that used to live
      here never actually loaded anything.
    */}
    <script is:inline set:html="document.documentElement.classList.add('js')" />
  </head>

  <body>
    <Nav current={vertical.id} />
    <main>
      <slot />
    </main>
    <Footer vertical={vertical} />
    <StickyBar vertical={vertical} />
  </body>
</html>
