---
import { valueOf, type Vertical } from "@bykami/content";
import SectionHeader from "./SectionHeader.astro";

/**
 * The catalogue, as crawlable text.
 *
 * Cards at every width. This used to be cards at 390px and a table from 768px,
 * on the reasoning that a table is the more scannable comparison — which is
 * true, and still lost. Neither reference brand puts a table on a sales page:
 * Cowboy shows four cards with an identical spec order and lets the repetition
 * do the comparing. A bordered grid of figures reads as a rate sheet rather
 * than a range of things you might buy, and it was the strongest single tell
 * that this page was built by an engineer rather than a shop. Dropping it also
 * removes the duplicate rendering, so there is one markup path to keep correct
 * instead of two.
 *
 * What makes cards comparable without a table is that every card lists the same
 * specs in the same order, so the eye can track down a column that is not drawn.
 *
 * Prices render whether or not they are owner-verified: they come from the
 * owner's own price list, which is the best source that exists. The verification
 * gate governs *structured data*, not what a human sees — a wrong number shown to
 * one visitor is recoverable, the same number quoted by every answer engine as
 * fact is not.
 */
interface Props {
  vertical: Vertical;
  heading?: string;
}

const { vertical, heading = "Paket & harga" } = Astro.props;

const idr = new Intl.NumberFormat("id-ID", {
  style: "currency",
  currency: "IDR",
  maximumFractionDigits: 0,
});

/**
 * Who a package suits, in words, so a first-timer can self-select without
 * reading every row — the job Cowboy's "The easy-rider" / "The explorer" does
 * for four near-identical bikes that would otherwise need a comparison table.
 *
 * Derived from headcount rather than authored. That is deliberate: it restates
 * a figure the card already prints, so it adds no claim the page was not
 * already making, and it cannot drift out of step with the number beside it.
 * Headcount is unverified and its source notes a conflict with YouCanBook.me,
 * which is a reason not to dress it up as an independent promise.
 */
function roleFor(max: number): string {
  if (max <= 1) return "Untuk sendiri";
  if (max <= 2) return "Untuk berdua";
  if (max <= 4) return "Untuk grup kecil";
  if (max <= 6) return "Untuk grup";
  return "Untuk rombongan";
}

const rows = vertical.offerings
  .slice()
  .sort((a, b) => a.orderIndex - b.orderIndex)
  .map((o) => {
    const price = valueOf(o.priceIDR);
    const duration = o.durationMinutes ? valueOf(o.durationMinutes) : undefined;
    const heads = o.headcount ? valueOf(o.headcount) : undefined;
    const prints = o.printsIncluded ? valueOf(o.printsIncluded) : undefined;

    const specs: { label: string; value: string }[] = [];
    if (duration !== undefined) specs.push({ label: "Durasi", value: `${duration} menit` });
    if (heads !== undefined) {
      specs.push({
        label: "Kapasitas",
        value: heads.min === heads.max ? `${heads.max} orang` : `${heads.min}–${heads.max} orang`,
      });
    }
    if (prints !== undefined) specs.push({ label: "Cetak", value: `${prints} cetak` });

    /*
     * One secondary line, not two. The owner's own description is the better
     * text wherever it exists; the derived role only stands in for packages
     * that have none, which is most of the self-photo range.
     */
    const blurb = o.description ?? (heads !== undefined ? roleFor(heads.max) : undefined);

    return {
      id: o.id,
      name: o.name,
      blurb,
      price: price === undefined ? null : idr.format(price),
      specs,
    };
  });
---

{
  rows.length > 0 && (
    <section id="harga" class="wrap section">
      <SectionHeader heading={heading} label="Harga" />

      <ul class="cards">
        {rows.map((r, i) => (
          /*
           * 16px of travel, not 24: these sit in a row of three and a card that
           * rises the full distance beside two others reads as the row being
           * unstable. Chimera's own 0/100/200ms across three, indexed by column
           * so the ramp restarts on each row rather than compounding.
           */
          <li
            class="card item"
            data-reveal
            data-reveal-y="16"
            style={`--reveal-delay: ${(i % 3) * 0.1}s`}
          >
            <h3>{r.name}</h3>

            {r.blurb && <p class="blurb muted">{r.blurb}</p>}

            {r.price ? (
              <p class="price tabular">{r.price}</p>
            ) : (
              <p class="price-ask muted">Harga spesial — tanya admin</p>
            )}

            {r.specs.length > 0 && (
              <dl class="spec ui tabular">
                {r.specs.map((s) => (
                  <Fragment>
                    <dt class="muted">{s.label}</dt>
                    <dd>{s.value}</dd>
                  </Fragment>
                ))}
              </dl>
            )}
          </li>
        ))}
      </ul>
    </section>
  )
}

<style>

  .cards {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .item {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-6);
  }

  h3 {
    margin: 0;
    font-size: 18px;
    letter-spacing: -0.3px;
  }

  .blurb {
    margin: 0;
    font-size: 14px;
  }

  /*
   * The price used to sit inline with the name, small and right-aligned, which
   * made it read as a table cell. On its own line at display size it becomes
   * the thing the card is about — the reference gives it more weight than the
   * package name, and the package name is not what anyone is deciding between.
   */
  .price {
    margin: var(--space-2) 0 0;
    font-size: 28px;
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.03em;
    white-space: nowrap;
  }

  /*
   * What stands where the price would on a package the studio quotes rather
   * than lists. The slot cannot simply be empty: these sit in a row of three,
   * and a card missing the one line every other card has reads as a card that
   * failed to load rather than as a package with a price worth asking about.
   *
   * Smaller than .price and free to wrap, because it is a sentence — 28px of it
   * would set the width of the column and shout down the numbers beside it.
   */
  .price-ask {
    margin: var(--space-2) 0 0;
    font-size: 18px;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  /*
   * `margin-top: auto` drops the specs to the floor of the card, so the rules
   * line up across a row even when one package carries a long description and
   * its neighbour carries a two-word role. Without it the hairlines sit at
   * three different heights and the row looks accidental.
   */
  .spec {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-2) var(--space-4);
    margin: 0;
    margin-top: auto;
    padding-top: var(--space-4);
    border-top: 1px solid var(--line);
  }

  .spec dt {
    font-weight: 400;
  }

  .spec dd {
    margin: 0;
    text-align: right;
  }

  @media (min-width: 640px) {
    .cards {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 960px) {
    .cards {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
