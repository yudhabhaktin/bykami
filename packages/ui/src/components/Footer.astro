---
import {
  instagramUrl,
  openingHoursText,
  tiktokUrl,
  valueOf,
  verticals,
  type Vertical,
} from "@bykami/content";

interface Props {
  vertical: Vertical;
}

const { vertical } = Astro.props;
const others = verticals.filter((v) => v.id !== vertical.id);

const address = vertical.nap ? valueOf(vertical.nap.address) : undefined;
const hours = vertical.nap ? valueOf(vertical.nap.openingHours) : undefined;

/*
 * Unverified handles still render, on the same rule the price list follows: the
 * gate governs structured data, not what a human sees. A visitor who follows a
 * wrong link finds a wrong profile and backs out; an answer engine told the same
 * thing repeats it as fact. So `valueOf` here, `publishedValueOf` in the JSON-LD.
 */
const instagram = vertical.social?.instagram ? valueOf(vertical.social.instagram) : undefined;
const tiktok = vertical.social?.tiktok ? valueOf(vertical.social.tiktok) : undefined;
---

<footer class="footer">
  <div class="wrap">
    <div class="cols">
      <div class="lead">
        <h2 class="brand">{vertical.displayName}</h2>
        <p class="muted tagline">{vertical.tagline}</p>
        {
          (instagram || tiktok) && (
            <ul class="social">
              {instagram && (
                <li>
                  <a class="muted" href={instagramUrl(instagram)} rel="me noopener">
                    Instagram @{instagram}
                  </a>
                </li>
              )}
              {tiktok && (
                <li>
                  <a class="muted" href={tiktokUrl(tiktok)} rel="me noopener">
                    TikTok @{tiktok}
                  </a>
                </li>
              )}
            </ul>
          )
        }
      </div>

      {
        (address || hours) && (
          <div>
            <h2 class="eyebrow">Lokasi</h2>
            {address && (
              <p class="muted">
                {address.streetAddress}
                <br />
                {address.addressLocality}
                <br />
                {address.addressRegion}
              </p>
            )}
            {hours && <p class="muted">{openingHoursText(hours)}</p>}
          </div>
        )
      }

      <div>
        <h2 class="eyebrow">bykami</h2>
        <ul>
          {
            others.map((v) => (
              <li>
                <a class="muted" href={`https://${v.hostname}`}>
                  {v.displayName}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <p class="muted fine">© {new Date().getFullYear()} bykami · Banyuwangi, Jawa Timur</p>
  </div>
</footer>

<style>
  .footer {
    margin-top: var(--space-section);
    border-top: 1px solid var(--line);
    background: var(--surface);
    padding-block: var(--space-12) var(--space-8);
  }

  .cols {
    display: grid;
    gap: var(--space-8);
  }

  /*
   * The brand column is given the wider track. Three equal columns made the
   * footer read as three lists of equal weight, when one of them is who this is
   * and the other two are where to find things.
   */
  @media (min-width: 768px) {
    .cols {
      grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr) minmax(0, 1fr);
      gap: var(--space-12);
    }
  }

  h2 {
    margin-block: 0 var(--space-3);
    letter-spacing: 0;
  }

  /*
   * All three headings used to be 14px `.ui`, which left the footer with no
   * anchor — the studio's name sat at exactly the weight of the word "Lokasi".
   * The name now carries the block and the other two became section labels, the
   * same marker the page uses above every section, so the footer is built from
   * the same parts as everything above it.
   */
  .brand {
    font-size: 24px;
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  .tagline {
    margin: 0;
    max-width: 34ch;
  }

  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    text-decoration: none;
  }

  .social {
    margin-top: var(--space-4);
  }

  /*
   * A rule rather than a gap. The copyright line was floating below three
   * columns of the same muted grey with nothing to say it belonged to a
   * different register.
   */
  .fine {
    /*
     * `max-width` is reset because the global `p` rule caps every paragraph at
     * the 68ch measure — right for prose, wrong for a rule that is supposed to
     * span the footer. Without this the border stops two thirds of the way
     * across and reads as a mistake.
     */
    max-width: none;
    margin-top: var(--space-12);
    padding-top: var(--space-6);
    border-top: 1px solid var(--line);
    font-size: 14px;
  }
</style>
