# Reference captures from third-party Instagram accounts.
# Kept local on purpose: these are someone else's copyrighted images,
# used here only to derive design direction. Never commit or publish them.
refs/screenshots/
refs/.playwright-raw/
refs/*.pdf

.DS_Store
node_modules/
dist/
# ...except this one. The agent embeds it, so the directory must exist on a
# clean checkout or `go build` fails on a missing embed pattern. The built
# bundle stays ignored; only the marker is committed.
!agent/internal/httpd/dist/
agent/internal/httpd/dist/*
!agent/internal/httpd/dist/.gitkeep
.astro/
.env
.claude/
.playwright-mcp/
.env.*
# SSH private keys. A key generated in a cloud console downloads once and cannot
# be re-fetched, so it tends to get parked wherever it landed — including here.
# This repo is public; one `git add -A` without this line publishes root access
# to the box.
*.pem
*.key
id_rsa*
id_ed25519*

# Ansible secrets and anything holding the tunnel token. The token is a bearer
# credential: whoever has it can register a connector and receive traffic for
# every hostname routed through the tunnel. It is passed in via -e or a vault
# file, never written into the roles.
ansible/vault_pass
ansible/*.vault.yml
ansible/r2vars.yml
ansible/*vars.local.yml
ansible/group_vars/*/vault.yml
ansible/inventory.local.yml
ansible/*.retry

terraform.tfstate
terraform.tfstate.backup
.terraform/
.terraform.lock.hcl
*.tfvars

# Local SQLite databases and the WAL/shm sidecars. Real data lives on the VPS
# and is backed up from there; a copy in the repo would be customer PII in a
# public repository.
*.db
*.db-wal
*.db-shm
