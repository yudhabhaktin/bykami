# Reference captures from third-party Instagram accounts.
# Kept local on purpose: these are someone else's copyrighted images,
# used here only to derive design direction. Never commit or publish them.
refs/screenshots/
refs/.playwright-raw/
refs/*.pdf

.DS_Store
node_modules/
dist/
.astro/
.env
.claude/
.playwright-mcp/
.env.*
# SSH private keys. The VPS deploy key is downloaded once from the Tencent
# console and cannot be re-fetched, so it tends to get parked wherever it landed
# — including here. This repo is public; one `git add -A` without this line
# publishes root access to the box.
*.pem
*.key
id_rsa*
id_ed25519*

terraform.tfstate
terraform.tfstate.backup
.terraform/
.terraform.lock.hcl
*.tfvars

# Local SQLite databases and the WAL/shm sidecars. Real data lives on the VPS
# and is backed up from there; a copy in the repo would be customer PII in a
# public repository.
*.db
*.db-wal
*.db-shm
