#!/bin/bash
# {{ ansible_managed }}
# Local edits are overwritten. Change roles/app/templates/ instead.
#
# Pull-based deploy. CI publishes a GitHub Release tagged api-<sha>; this reads
# it and installs. Nothing reaches into the box, which is why it has no inbound
# rule to open and no CI credential to leak.
set -euo pipefail

REPO="{{ app_release_repo }}"
BIN="{{ app_install_path }}"
PREV="{{ app_install_path }}.previous"
VERSION_FILE="{{ app_data_dir }}/.deployed-version"
HEALTH="http://{{ app_listen_addr }}/healthz"
SERVICE="{{ app_name }}"

log() { echo "[bykami-update] $*"; }

# The most recent release whose tag starts with api-. Not /releases/latest:
# that returns the newest release of any kind, so the first non-api release
# published would start feeding this script the wrong artifact.
#
# The explicit sort is not decoration. GitHub's list endpoint does not reliably
# return releases newest-first — observed on 2026-07-26 returning an older
# release ahead of a newer one — so taking the first match would install a
# stale binary, or appear to sit on the current version forever while new ones
# were published. Sort on published_at, falling back to created_at for a
# release that has somehow not been published.
tag=$(curl -fsSL --max-time 30 \
        -H "Accept: application/vnd.github+json" \
        "https://api.github.com/repos/$REPO/releases?per_page=100" \
      | python3 -c '
import json, sys
rs = [r for r in json.load(sys.stdin)
      if r["tag_name"].startswith("api-") and not r["draft"] and not r["prerelease"]]
rs.sort(key=lambda r: r.get("published_at") or r.get("created_at") or "", reverse=True)
if rs:
    print(rs[0]["tag_name"])
')

if [ -z "$tag" ]; then
    log "no api-* release found; nothing to do"
    exit 0
fi

current=$(cat "$VERSION_FILE" 2>/dev/null || echo "none")
if [ "$tag" = "$current" ]; then
    log "already on $tag"
    exit 0
fi

log "current=$current available=$tag"

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

base="https://github.com/$REPO/releases/download/$tag"
curl -fsSL --max-time 120 -o "$tmp/bykami"        "$base/bykami"
curl -fsSL --max-time 30  -o "$tmp/bykami.sha256" "$base/bykami.sha256"

# Verify before anything touches the running system. The checksum proves the
# download is intact, not that it is trustworthy — anyone who can push to main
# can publish a release, which is the same trust boundary as any CI deploy.
# Signing would close that; it is not done here.
cd "$tmp"
if ! sha256sum -c bykami.sha256 >/dev/null 2>&1; then
    log "CHECKSUM MISMATCH for $tag — refusing to install"
    exit 1
fi
cd - >/dev/null

chmod 0755 "$tmp/bykami"

# Keep the outgoing binary so a failed health check has something to go back
# to. cp, not mv: if this is the first install there is nothing to preserve.
[ -f "$BIN" ] && cp -a "$BIN" "$PREV"

# Same filesystem, so this is atomic — no window where the path exists but is
# half-written, which is what a plain cp onto a running binary would risk.
mv "$tmp/bykami" "$BIN"

log "installed $tag, restarting $SERVICE"
systemctl restart "$SERVICE"

# The gate. /healthz touches the database, so a 200 means the new binary can
# reach its own storage — not merely that the process survived exec.
for i in $(seq 1 15); do
    if curl -fsS --max-time 3 "$HEALTH" >/dev/null 2>&1; then
        echo "$tag" > "$VERSION_FILE"
        log "healthy on $tag"
        exit 0
    fi
    sleep 2
done

log "UNHEALTHY after installing $tag"

if [ -f "$PREV" ]; then
    log "rolling back to the previous binary"
    mv "$PREV" "$BIN"
    systemctl restart "$SERVICE"
    # Deliberately not written to VERSION_FILE: the rollback restores the
    # binary but the file still names the last version that passed, so the next
    # run retries rather than treating the bad release as installed.
    log "rolled back"
else
    log "no previous binary to roll back to"
fi

exit 1
