#!/bin/bash
# {{ ansible_managed }}
# bash, not sh: the R2 section below uses `local`, which dash supports only as
# an extension and POSIX does not define at all.
# Local edits are overwritten. Change roles/app/templates/ instead.
set -eu

# 0600 on everything created below. sqlite3 honours the umask, and without this
# the backup lands 0644 — a world-readable copy of the customer database. The
# 0750 directory hides it today, which is exactly the kind of protection that
# quietly disappears when someone widens the directory for an unrelated reason.
umask 077

DB="{{ app_data_dir }}/{{ app_name }}.db"
DIR="{{ app_backup_dir }}"
KEEP={{ app_backup_keep }}

[ -f "$DB" ] || { echo "no database at $DB yet, nothing to back up"; exit 0; }

stamp=$(date -u +%Y%m%dT%H%M%SZ)
out="$DIR/{{ app_name }}-$stamp.db"

# sqlite3 .backup, not cp. The database runs in WAL mode, so a file copy can
# catch a checkpoint mid-flight and produce a backup that restores to a torn
# state — and it will usually look fine, because the damage is in pages the
# restore does not touch until later. .backup uses SQLite's online backup API,
# which is consistent against a live writer.
sqlite3 "$DB" ".backup '$out'"

# Prove it before trusting it. A backup nobody has opened is a hypothesis.
if ! sqlite3 "$out" 'PRAGMA integrity_check;' | grep -qx ok; then
    echo "integrity check FAILED for $out" >&2
    rm -f "$out"
    exit 1
fi

# Keep the newest $KEEP, drop the rest. Filenames sort chronologically because
# the stamp is ISO-8601 UTC, so lexical order is time order.
ls -1 "$DIR"/{{ app_name }}-*.db 2>/dev/null \
    | sort -r \
    | tail -n +$((KEEP + 1)) \
    | while read -r old; do rm -f "$old"; done

echo "backup ok: $out"

{% if app_r2_enabled %}
# ---------------------------------------------------------------------------
# Off-box copy to R2.
#
# Everything above this line has already succeeded, and the local backup is
# kept whatever happens here. A failed upload must not fail the backup — losing
# the off-box copy is bad, losing the local one because the network blipped is
# worse.
# ---------------------------------------------------------------------------
RCLONE="rclone --config /etc/rclone/r2.conf"
REMOTE="r2:{{ app_r2_bucket }}"
BUDGET={{ app_r2_budget_bytes }}
R2_KEEP={{ app_r2_keep }}

r2_total() {
    # Bytes currently stored. --json so this does not depend on parsing a
    # human-readable size that changes format between rclone versions.
    $RCLONE size "$REMOTE" --json 2>/dev/null \
        | python3 -c 'import json,sys; print(json.load(sys.stdin).get("bytes",0))' 2>/dev/null \
        || echo 0
}

r2_oldest() {
    # Names are ISO-8601 UTC, so lexical order is chronological.
    $RCLONE lsf "$REMOTE" 2>/dev/null | grep -E '^{{ app_name }}-.*\.db$' | sort
}

r2_prune_to_count() {
    r2_oldest | head -n -"$R2_KEEP" | while read -r old; do
        echo "  pruning by count: $old"
        $RCLONE deletefile "$REMOTE/$old" 2>/dev/null || true
    done
}

r2_prune_to_budget() {
    # Prune until the total is at or below $1 — the caller passes the space the
    # new backup needs, not the raw cap.
    #
    # Pruning to the cap itself would be the wrong target and is a mistake worth
    # naming: it leaves no room for the upload, so the newest backup is refused
    # while older ones are kept. That is backwards. The most recent backup is
    # the one worth having, so the rule is drop oldest, keep newest.
    local target=$1
    local total
    total=$(r2_total)
    while [ "$total" -gt "$target" ]; do
        oldest=$(r2_oldest | head -1)
        [ -z "$oldest" ] && break
        echo "  pruning by budget: $oldest (${total}B > ${target}B available)"
        $RCLONE deletefile "$REMOTE/$oldest" 2>/dev/null || break
        total=$(r2_total)
    done
}

upload() {
    size=$(stat -c %s "$out")
    total=$(r2_total)

    # Make room BEFORE uploading, not after. Uploading first and pruning second
    # means the bucket transiently exceeds the cap, which is exactly the moment
    # a free tier stops being free.
    # A single backup larger than the entire cap is a configuration error, not
    # something to prune around — deleting every previous copy still would not
    # make it fit, so refuse while the old ones are intact.
    if [ "$size" -gt "$BUDGET" ]; then
        echo "  REFUSING: one backup (${size}B) exceeds the entire ${BUDGET}B cap" >&2
        return 1
    fi

    if [ $((total + size)) -gt "$BUDGET" ]; then
        echo "  budget: ${total}B stored + ${size}B new > ${BUDGET}B cap, making room"
        r2_prune_to_budget $((BUDGET - size))
    fi

    $RCLONE copyto "$out" "$REMOTE/$(basename "$out")" || return 1

    # Replaces the post-upload HEAD that no_head disables. Ask R2 how big the
    # object actually is and compare — a backup that uploaded as zero bytes
    # would otherwise sit there looking like a backup until the day it matters.
    remote_size=$($RCLONE lsl "$REMOTE/$(basename "$out")" 2>/dev/null | awk '{print $1}')
    if [ "$remote_size" != "$size" ]; then
        echo "  UPLOAD SIZE MISMATCH: local ${size}B, remote ${remote_size:-missing}B" >&2
        return 1
    fi

    r2_prune_to_count
    echo "  r2 ok: $(basename "$out") ${size}B verified, $(r2_total)B of ${BUDGET}B used"
}

if upload; then
    :
else
    echo "r2 upload FAILED — local backup at $out is unaffected" >&2
fi
{% endif %}
