# {{ ansible_managed }}
[Unit]
Description=Back up the bykami SQLite database
After={{ app_name }}.service

[Service]
Type=oneshot
User={{ app_user }}
Group={{ app_user }}
ExecStart=/usr/local/bin/{{ app_name }}-backup

# The service user has no home and ProtectHome hides one anyway, so rclone
# would fail trying to create a cache directory. PrivateTmp gives this unit its
# own /tmp, discarded when it exits.
Environment=XDG_CACHE_HOME=/tmp
Environment=HOME=/tmp

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
# Both paths. The data directory is not a typo and not over-permission: opening
# a WAL database requires writing its -shm sidecar even to read, so a read-only
# data directory makes sqlite3 fail to open the file at all.
ReadWritePaths={{ app_backup_dir }} {{ app_data_dir }}
ProtectHome=true
